# Server Configuration
PORT=8080
HOST=localhost

# Playwright Configuration
# Path to Google Chrome executable. If not set, Playwright uses its bundled browser.
# Windows Example: C:\Program Files\Google\Chrome\Application\chrome.exe
# MacOS Example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux Example: /usr/bin/google-chrome
CHROME_EXECUTABLE_PATH=

# Logging
LOG_LEVEL=info

# Browser
# Set to 'true' to launch Chrome in full screen/maximized mode
CHROME_START_MAXIMIZED=false

# Recording
# Set to 'true' to enable video recording of sessions
RECORDING_ENABLED=false
