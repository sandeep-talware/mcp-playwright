# Server Configuration
PORT=8080
HOST=localhost

# Playwright Configuration
# Paste your Chrome Executable Path below
CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Logging
LOG_LEVEL=info

# Browser
# Set to 'true' to launch Chrome in full screen/maximized mode
CHROME_START_MAXIMIZED=true

# Recording
# Set to 'true' to enable video recording of sessions
RECORDING_ENABLED=false
